{
    "name": "ithihasmadala.github.io",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 420",
        "build": "next build",
        "start": "next start -p 420",
        "lint": "next lint",
        "deploy": "pnpm run build && touch out/.nojekyll && npx gh-pages -d out -t true"
    },
    "dependencies": {
        "@react-three/drei": "^9.114.0",
        "@react-three/fiber": "^8.17.9",
        "antd": "^5.21.2",
        "framer-motion": "^11.11.1",
        "konva": "^9.3.15",
        "next": "15.5.27",
        "next-seo": "^6.6.0",
        "prettier": "^3.3.3",
        "react": "^18",
        "react-dom": "^18",
        "react-konva": "^18.2.10",
        "three": "^0.169.0"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@types/three": "^0.169.0",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^8.56.0",
        "eslint-config-next": "15.5.27",
        "eslint-config-prettier": "^8.5.0",
        "gh-pages": "^6.3.0",
        "typescript": "^5"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "pnpm": {
        "overrides": {
            "nanoid@<3.3.18": "3.3.18",
            "brace-expansion@^2.0.1": "2.1.7",
            "brace-expansion@^1.1.11": "1.1.21",
            "minimatch@^3": "3.1.4",
            "minimatch@^9": "9.0.9",
            "cross-spawn@^7": "7.0.6",
            "glob@^10": "10.5.0",
            "@babel/runtime@^7": "7.28.4",
            "js-yaml@^4": "4.3.2",
            "ajv@^6": "6.14.0",
            "flatted@^3": "3.4.2",
            "picomatch@^2": "2.3.2",
            "postcss@^8": "8.5.28",
            "uuid@^9": "11.1.1",
            "fflate@^0.8": "0.8.3",
            "fflate@^0.6": "0.6.11"
        }
    },
    "packageManager": "pnpm@9.15.9"
}
